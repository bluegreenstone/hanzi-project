  "definitions_zh_TW": [
    {
      "text": "1.借物摩擦而使物品光滑或銳利。[例]磨光、磨刀　◎\r\n2.將東西碾壓成細末狀。[例]研磨、磨碎\r\n3.消滅、泯滅。[例]磨滅\r\n4.艱難、阻礙。[例]磨難、好事多磨\r\n5.糾纏。[例]這小孩真磨人！\r\n6.拖延。[例]磨蹭、磨時間",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0547",
      "verbatim": true
    },
    {
      "text": "用來碾碎穀物等東西的器具。[例]石磨、磨房",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0578",
      "verbatim": true
    }
