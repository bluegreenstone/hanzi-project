  "definitions_zh_TW": [
    {
      "text": "1.命令、法令。[例]軍令、人事命令\n2.時節。[例]時令、節令、夏令\n3.讓、使得。[例]令人難堪\n4.好的、善的。[例]令德、令譽、令名\n5.敬辭。用以尊稱他人的親屬。[例]令尊、令堂、令郎\n6.詞、曲中小令的簡稱。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
