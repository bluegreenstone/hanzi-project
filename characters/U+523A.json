  "definitions_zh_TW": [
    {
      "text": "1.以尖銳的東西扎入。[例]穿刺、刺繡　◎\n2.細而尖銳如針的東西。[例]芒刺、魚刺\n3.以尖酸刻薄的言語指出或嘲笑別人的過失。[例]諷刺、譏刺\n4.因外物刺激使產生不好的感覺。[例]刺眼、刺耳、刺鼻\n5.暗殺。[例]行刺、刺殺、遇刺\n6.暗中打聽。[例]刺探\n7.名片、名帖。[例]名刺、刺帖、投刺",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5436",
      "verbatim": true
    }
