  "definitions_zh_TW": [
    {
      "text": "1.疑問指稱詞。[例]哪天、哪裡人\n2.怎麼。表示反問。[例]哪能、哪會、哪知道",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1585",
      "verbatim": true
    },
    {
      "text": "1.助詞。表示加強語氣用。[例]同志們加油哪！\n2.嘆詞。[例]天哪！怎麼會發生這種事？",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1593",
      "verbatim": true
    },
    {
