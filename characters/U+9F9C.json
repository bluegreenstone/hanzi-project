  "definitions_zh_TW": [
    {
      "text": "動物名。爬行綱龜鱉目龜科。身體橢圓而扁，腹、背皆有硬殼。頭似蛇，四肢短，頭、尾和腳都可縮入甲殼內。行動遲緩，性耐飢渴，壽命長達百年之上。其肉可食，殼可入藥。[例]烏龜、海龜 　◎",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2418",
      "verbatim": true
    },
    {
      "text": "→龜裂",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3509",
      "verbatim": true
    },
    {
      "text": "→龜茲",
