  "definitions_zh_TW": [
    {
      "text": "1.戰勝。[例]克敵致勝、攻無不克\n2.制服、約束。[例]克服、克己復禮\n3.能夠。[例]不克前來、不克分身\n4.量詞。計算重量的單位。即公克的簡稱。公制一克等於千分之一公斤。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
