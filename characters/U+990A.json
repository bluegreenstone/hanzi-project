  "definitions_zh_TW": [
    {
      "text": "1.照顧、撫育。[例]撫養、領養、養育\n2.培植或飼餵。[例]養蘭、養雞、飼養\n3.陶冶、形成。指習慣或性情。[例]養成習慣、潔身養廉、修身養性\n4.治療、調護。[例]保養、調養、養病\n5.對生長或保健有益的。[例]養分、養料\n6.經認領撫育而沒有親生關係的。[例]養母、養子\n7.維修。[例]養路、養護工程\n8.扶持、資助。[例]以會養會",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "6179",
      "verbatim": true
    },
    {
      "text": "晚輩供養長輩。[例]奉養父母、祭豐不如養薄",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "6184",
      "verbatim": true
    }
  ],
