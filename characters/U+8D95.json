  "definitions_zh_TW": [
    {
      "text": "1.加速行動。[例]趕路、趕工、趕緊\n2.追。[例]追趕、迎頭趕上\n3.在後面驅策、催促。[例]趕牛、趕鴨子\n4.等到。[例]趕明兒\n5.碰到。[例]整修房屋偏趕上颳颱風，真是天公不作美。\n6.急促、匆忙。[例]這次行程安排的太趕了。\n7.趁著。[例]有事就趕早兒辦好。\n8.來得及。[例]趕上末班車。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2286",
      "verbatim": true
