  "definitions_zh_TW": [
    {
      "text": "1.獲取。與「失」相對。[例]獲得、得獎、得來不易\n\t\n2.契合、適宜。[例]得體、得法、相得益彰\n\t\n3.可以、能夠。[例]得過且過、不得無禮、得饒人處且饒人\n\t\n4.快意、滿足。[例]自得、得意\n\t\n5.遇。[例]得便、得空、得閒\n\t\n6.夠了。多用於談話時表反對、禁止或同意。[例]得了，別再出餿主意了！\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1016",
      "verbatim": true
    },
    {
      "text": "助詞。用在動詞、形容詞後面，表示結果或性狀。[例]跑得快、美得冒泡",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1021",
      "verbatim": true
    },
    {
      "text": "應該、必須、需要。[例]他總得把工作交代清楚再離職吧？",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1043",
      "verbatim": true
    }
  ],
