  "definitions_zh_TW": [
    {
      "text": "1.用容器裝東西。[例]盛飯、盛湯\n2.容納。[例]箱子太小，盛不了這麼多東西。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4784",
      "verbatim": true
    },
    {
      "text": "1.強壯、興旺。與「衰」相對。[例]興盛、旺盛、強盛\n2.強烈、旺盛的。[例]年輕氣盛、火勢很盛\n3.隆重的、壯觀的。[例]盛大、盛舉、盛事\n4.深濃。[例]盛情、盛意\n5.極、甚。[例]盛怒、盛誇、盛贊\n6.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
