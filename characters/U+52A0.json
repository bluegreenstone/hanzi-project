  "definitions_zh_TW": [
    {
      "text": "1.增益、增添。與「減」相對。[例]增加、加股、加倍\n2.數學上指兩個數目的結合。[例]三加五等於八。\n3.將一物與另一物相結合。[例]這杯咖啡太過苦澀，請再幫我加些牛奶。\n4.施、置。[例]加害\n5.戴上。[例]加冕、加冠",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
