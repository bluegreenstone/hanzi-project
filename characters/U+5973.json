  "definitions_zh_TW": [
    {
      "text": "1.女性、女人。與「男」相對。[例]才女、新女性\r\n2.女兒。[例]生兒育女\r\n3.二十八星宿之一，北方玄武宿的第二宿，共有四顆星。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1731",
      "verbatim": true
    },
    {
      "text": "將女兒嫁與他人。[例]以女女人",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1732",
      "verbatim": true
    },
    {
      "text": "你。同「汝」。",
