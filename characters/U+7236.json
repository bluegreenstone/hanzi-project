  "definitions_zh_TW": [
    {
      "text": "1.古代對男子的美稱。同「甫」。\n2.對老年人的通稱。[例]漁父、田父",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0970",
      "verbatim": true
    },
    {
      "text": "稱謂：(1) 對爸爸的稱呼。[例]父親、養父、家父　(2) 用以尊稱親族中男性的長輩。[例]伯父、叔父、舅父　(3) 對老年人的尊稱。[例]父老",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
