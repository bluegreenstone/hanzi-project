  "definitions_zh_TW": [
    {
      "text": "1.行政機關或商店的名稱。[例]郵局、書局、教育局\n2.形勢、情況。[例]局勢、顧全大局、打破僵局\n3.聚會。[例]飯局、牌局、賭局\n4.圈套、陷阱。[例]騙局\n5.拘束、限制。通「拘」。[例]局限、局促、局囿\n6.部分。[例]局部麻醉\n7.量詞。計算棋類或球類等活動的單位。[例]對弈兩局、幸運第七局",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
