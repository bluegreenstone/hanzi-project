  "definitions_zh_TW": [
    {
      "text": "1.政府派員駐守的關口或收稅的地方。[例]關卡\n2.被夾住或堵塞而不能活動。[例]他被卡在兩部車中間，動彈不得。\n3.硬紙片。§英card[例]聖誕卡、生日卡、賀年卡\n4.卡路里的簡稱。[例]十卡熱量",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2490",
      "verbatim": true
    },
