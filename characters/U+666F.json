  "definitions_zh_TW": [
    {
      "text": "1.太陽光。[例]浮景、春和景明\n2.風光、形象。[例]美景、景物、山景\n3.情況、境遇。[例]家景、景況、晚景淒涼\n4.敬慕、佩服。[例]景仰\n5.戲劇中因布幕不同而劃分的段落。[例]第一幕第三景",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
