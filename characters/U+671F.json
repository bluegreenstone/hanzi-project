  "definitions_zh_TW": [
    {
      "text": "1.周年。[例]期年\n2.喪服中期服的簡稱。[例]外無期功彊近之親，內無應門五尺之僮。（《文選．李密．陳情表》）",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3005",
      "verbatim": true
    },
    {
      "text": "1.時日或特定的一段時間。[例]限期、學期、日期\n2.希冀、盼望。[例]期待、期許、期望\n3.約定。[例]不期而遇\n4.量詞。計算事物分期的單位。[例]訓練計畫一年分為四期。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3547",
      "verbatim": true
    }
