  "definitions_zh_TW": [
    {
      "text": "姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5203",
      "verbatim": true
    },
    {
      "text": "1.職責、職務。[例]責任、任務、重任\n2.職位。[例]就任、赴任、卸任\n3.委用。[例]派任、任免\n4.聽憑。[例]任意、任由、任其自然\n5.擔當、承擔。[例]任職、任教\n6.無論。[例]他現在正在氣頭上，任你怎麼解釋，他都不會聽的。\n7.相信、信賴。[例]信任\n8.量詞。計算擔任某種職務或具有某種身分期間的單位。[例]他連續當選三任會長。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5214",
      "verbatim": true
    }
