  "definitions": [
    {
      "gloss": "possessive, adjectival suffix",
      "lang": "en",
      "register": "modern",
      "source_id": "unicode-unihan-17.0.0"
    },
    {
      "gloss": "of; ~'s (possessive particle)",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
      "gloss": "(used after an attribute when it modifies a noun)",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
      "gloss": "(used at the end of a declarative sentence for emphasis)",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
      "gloss": "(used after a noun, verb or adjective to form a nominal expression, as in 皮革的[pi2 ge2 de5] \"one made of leather\" or 跑堂兒的|跑堂儿的[pao3 tang2 r5 de5] \"a waiter (literally, one who runs back and forth in a restaurant)\" or 新的[xin1 de5] \"new one\")",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
      "gloss": "also pr. [di4] or [di5] in poetry and songs",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
      "gloss": "a taxi; a cab (abbr. for 的士[di1 shi4])",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
