  "definitions_zh_TW": [
    {
      "text": "1.一樣的。與「異」相對。[例]大同小異、異口同聲、志同道合\n2.一齊、一起。[例]同舟共濟、同甘共苦、同心協力\n3.贊成。[例]贊同、同意\n4.會合、聚集。[例]會同\n5.和諧、和平。[例]世界大同\n6.和、與、跟。[例]我同他一起看電影。\n7.契約。[例]合同\n8.→胡同",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
