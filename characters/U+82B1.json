  "definitions_zh_TW": [
    {
      "text": "1.種子植物的繁殖器官。由花瓣、花萼、花托、花蕊組合，可供人觀賞。[例]菊花、梅花、桃花　◎\r\n2.形狀像花的物體。[例]浪花、雪花、爆米花\r\n3.比喻女人。[例]姊妹花、交際花、尋花問柳\r\n4.有圖紋的、雜色的。[例]花邊、花布、花貓\r\n5.式樣、種類繁多的。[例]花絮、花式\r\n6.虛假的、巧妙的。[例]花招、花言巧語\r\n7.模糊不清。[例]頭昏眼花\r\n8.心性不定、好玩樂的。[例]花心\r\n9.耗費。[例]花費、花錢、花時間\r\n10.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2843",
      "verbatim": true
    }
