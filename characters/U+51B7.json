  "definitions_zh_TW": [
    {
      "text": "1.感覺溫度低。與「熱」相對。[例]寒流來了，今天好冷！　◎\n2.淡漠、不熱烈。[例]冷淡、冷漠、冷場\n3.寂靜、寂寞。[例]冷冷清清\n4.鄙視、譏刺。[例]冷言冷語\n5.不受歡迎的、無人過問的。[例]冷門、冷貨\n6.突然。[例]冷槍、冷不防\n7.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
