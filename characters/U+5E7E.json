  "definitions_zh_TW": [
    {
      "text": "1.細微。[例]幾希、幾微\n2.將近、相去不遠。[例]幾乎、庶幾\n3.預兆、細微的跡象。[例]幾兆、治亂存亡之幾",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3016",
      "verbatim": true
    },
    {
      "text": "1.疑問詞：(1) 詢問數目。[例]今晚一共有幾個人要來？ 　(2) 詢問時間。[例]你今晚幾時來的 ？\n2.表示大於一，而小於十的不定數目。[例]幾千元、十幾人",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
