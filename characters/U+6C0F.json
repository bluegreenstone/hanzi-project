  "definitions": [
    {
      "gloss": "clan, family; mister",
      "lang": "en",
      "register": "modern",
      "source_id": "unicode-unihan-17.0.0"
    },
    {
      "gloss": "(bound form) family name; surname (as in 王氏[Wang2 shi4] \"the Wang clan\")",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
      "gloss": "(bound form) maiden name; née (as in 李王氏[Li3 Wang2 shi4] \"Mrs. Li, née Wang\")",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
      "gloss": "(bound form) honorific suffix added to the surname or full name of a notable person, esp. historical or scholarly figures",
      "lang": "en",
      "register": "modern",
      "source_id": "cc-cedict-editor-2026-08-11"
    },
    {
