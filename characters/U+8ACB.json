  "definitions_zh_TW": [
    {
      "text": "舊時官員進見君主或參加朝會。[例]朝請、秋請",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3404",
      "verbatim": true
    },
    {
      "text": "1.懇求、乞求。對人有所要求的敬詞。[例]敬請、請問、請教\n2.做東招待。[例]請客\n3.延聘。[例]請家教、請大夫\n4.問候。[例]請安\n5.求取。[例]請香案、請了一座神像",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3742",
      "verbatim": true
    }
  ],
