  "definitions_zh_TW": [
    {
      "text": "動物名。脊椎動物偶蹄目野豬科。形狀像豬，身體呈圓桶狀，皮黑而厚，覆滿粗毛，生氣時毛髮倒豎。鼻長而硬，犬齒鋒利，露於口外，與鼻配合，適於挖地覓食。棲息於山林野地，為雜食性動物，菌姑、竹筍、蟲、魚、鼠類皆可為食，是家豬的原種。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
