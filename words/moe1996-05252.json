  "definitions_zh_TW": [
    {
      "text": "1.人參、沙參等藥材的總稱。一般多指人參。\n2.星座名。二十八星宿之一。位於西方白虎七宿的末端。[例]參商",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5055",
      "verbatim": true
    },
    {
      "text": "1.加入。[例]參戰、參選、參軍\n2.驗查、驗證。[例]參考、參照\n3.商討、研究。[例]參禪、參透、參話頭\n4.進謁。[例]參拜、參見",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
