  "definitions_zh_TW": [
    {
      "text": "助詞。置於副詞之後。同「的」。[例]慢慢地吃、好好地玩",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1018",
      "verbatim": true
    },
    {
      "text": "1.人類萬物棲息生長的處所。與「天」相對。[例]大地、天地\n2.指地球。[例]地心\n3.田地、土地。[例]耕地、荒地、地盡其利\n4.場所。[例]發源地、目的地、根據地\n5.區域。[例]本地、殖民地、臺灣各地\n6.地位、立場。[例]易地而處、設身處地\n7.本性、心思、意志的領域。[例]見地、心地\n8.本質、底子。[例]質地\n9.助詞。用於副詞語尾。[例]忽地、驀地",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1147",
      "verbatim": true
    }
  ]
