  "definitions_zh_TW": [
    {
      "text": "酒店。§英bar[例]吧檯、酒吧  ",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0005",
      "verbatim": true
    },
    {
      "text": "助詞：(1) 表示商量、請求等語氣。[例]教教我吧！　(2) 表示指使。[例]快走吧！　(3) 表示同意。[例]好吧！　(4) 表示推測。[例]明天該不會下雨吧！　(5) 表示感嘆。[例]算了吧！  ",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
