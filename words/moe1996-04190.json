  "definitions_zh_TW": [
    {
      "text": "1.亡失、丟掉。[例]遺失\n2.脫漏。[例]遺忘、遺漏、暴露無遺\n3.捨棄、離開。[例]遺世獨立\n4.留下。[例]不遺餘力、遺臭萬年、養虎遺患\n5.亡失的東西。[例]路不拾遺\n6.留下的、剩餘未盡的。[例]遺墨、遺跡、遺言",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5868",
      "verbatim": true
    },
