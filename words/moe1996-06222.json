  "definitions_zh_TW": [
    {
      "text": "1.急驟、猛烈。[例]暴風、暴雨、暴飲暴食\n2.殘酷凶惡。[例]殘暴、暴虐、暴行\n3.鼓起、突出。[例]他氣得頭上的青筋都暴出來了。\n4.毀壞、蹧蹋。[例]暴殄天物、自暴自棄",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0110",
      "verbatim": true
    },
    {
