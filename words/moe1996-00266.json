  "definitions_zh_TW": [
    {
      "text": "1.不容易、艱困。與「易」相對。[例]難關、難題、知難行易\n2.不可、不能。[例]難保、難言之隱\n3.不好。[例]難看、難吃\n4.阻梗、困住。[例]為難",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1622",
      "verbatim": true
    },
    {
      "text": "1.災禍。[例]災難、大難臨頭\n2.叛亂。[例]發難、兵難\n3.質問、責備。[例]非難、責難、問難",
      "lang": "zh-Hant-TW",
