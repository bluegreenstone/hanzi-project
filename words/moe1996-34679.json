  "definitions_zh_TW": [
    {
      "text": "朝代名。（西元618～906）李淵代隋，國號唐，二十帝，二百八十九年。唐朝建都長安，與漢朝並稱為中國歷史上最富強的盛世。當時文化優越，版圖遼闊，聲威遠播，對鄰近諸國，有深遠的影響。",
      "lang": "zh-Hant-TW",
