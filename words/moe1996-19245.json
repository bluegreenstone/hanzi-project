  "definitions_zh_TW": [
    {
      "text": "樂器名。一種膜鳴樂器。為英語timpani的意譯。鼓身用銅製成，狀似碗，鼓面蒙皮，以金屬環固定，四周裝有螺絲，可調節皮面的鬆緊，調整所需的音高。因兼有敲擊樂器和定音樂器的性格，所以常用於管弦樂團中，通常五個為一組。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
