  "definitions_zh_TW": [
    {
      "text": "依據。[例]放於利而行，多怨。（《論語．里仁》）",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0903",
      "verbatim": true
    },
    {
      "text": "1.從約束或緊張狀態中解脫、鬆開。[例]放開、放鬆、放心　◎\n2.捨棄、拋開。[例]放棄\n3.解散。[例]放學、放工\n4.放縱、任由。[例]放聲高歌、放言高論\n5.發出。[例]施放、放款、放風聲\n6.開、展。[例]心花怒放、百花開放\n7.放蕩、不拘束。[例]豪放、狂放、奔放\n8.安置。[例]陳放、安放、放書\n9.任官職，多指到外地任職而言。[例]外放、下放\n10. 因罪而遭遣逐。[例]流放、放逐",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0910",
      "verbatim": true
    }
  ]
