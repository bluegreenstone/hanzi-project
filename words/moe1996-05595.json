  "definitions_zh_TW": [
    {
      "text": "植物名。繖形科胡蘿蔔屬，二年生草本。莖單生，葉二至三回羽狀分裂，末端裂片線形或線狀披針形。複繖形花序，繖輻多枝；花黃色或淡紅色，細小、密集。根部長圓錐形，肥大，有紫紅、橘紅、黃色等多種，可供食用。原產於歐洲。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
