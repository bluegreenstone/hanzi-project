  "definitions_zh_TW": [
    {
      "text": "位於最小支氣管的末端，是肺臟的實質組織最末端的分支，形似小泡。由單層薄膜構成，外繞微血管，血液在此進行氣體交換。成人肺中肺泡數目約為3億個。也稱為「氣胞」。",
      "lang": "zh-Hant-TW",
