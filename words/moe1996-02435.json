  "definitions_zh_TW": [
    {
      "text": "1.儲存東西的地方或儲藏的珍貴物品。[例]帑藏、寶藏\r\n2.西藏的簡稱。\r\n3.中國的邊疆民族之一。主要分布於大陸地區西藏、青海一帶。舊稱為「吐蕃」。\r\n4.佛教、道教經典的總稱。[例]道藏、經藏",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5365",
      "verbatim": true
    },
    {
