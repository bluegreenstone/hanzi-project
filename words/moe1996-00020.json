  "definitions_zh_TW": [
    {
      "text": "1.各數相加的總數。[例]總和\n2.平息爭端、停止爭鬥。[例]和解、講和、議和\n3.親睦、調諧。[例]和睦、和諧\n4.溫順、安詳。[例]和氣、和藹\n5.溫暖。[例]和煦、風和日麗\n6.對、向。[例]晚輩和尊長講話的態度要恭敬。\n7.與、跟。[例]我和他是好朋友。\n8.連同、連帶。[例]和衣而眠、和衣而臥\n9.日本或日本的。[例]大和、和服",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2677",
      "verbatim": true
    },
    {
      "text": "1.聲音相應。[例]附和、唱和\n2.依原詩格律或內容作詩以酬答他人。[例]和詩",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2698",
      "verbatim": true
    },
    {
      "text": "(一)7.的語音。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2771",
      "verbatim": true
    },
    {
      "text": "牌戲中某一方的牌已湊齊成副而獲勝稱為「和」。[例]和牌",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2808",
      "verbatim": true
    },
    {
      "text": "攪拌、混合。[例]攪和、和麵",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2866",
      "verbatim": true
    },
    {
      "text": "溫暖的。[例]暖和",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2877",
      "verbatim": true
    }
  ]
