  "definitions_zh_TW": [
    {
      "text": "1.停止。[例]罷工、欲罷不能\n2.免除、廢止。[例]罷免、罷官\n3.終了、完畢。[例]吃罷、語罷\n4.嘆詞。表示失望、忿恨等的語氣。[例]罷了！罷了！說再多都沒有用了。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0020",
      "verbatim": true
    },
    {
      "text": "同「吧」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0024",
      "verbatim": true
    },
    {
      "text": "勞乏、困倦。通「疲」。",
