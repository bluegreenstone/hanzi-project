  "definitions_zh_TW": [
    {
      "text": "1.包含、收納。[例]容納、容身之所、無地自容\n2.寬待、原諒。[例]包容、見容、寬容\n3.面貌。[例]儀容、面容、容貌\n4.修飾、妝扮。[例]女為悅己者容\n5.允、可。[例]容許、不容置喙\n6.或許、也許。[例]容或有之\n7.姓。",
      "lang": "zh-Hant-TW",
