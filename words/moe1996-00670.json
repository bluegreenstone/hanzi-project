  "definitions_zh_TW": [
    {
      "text": "1.固執、不柔順。[例]倔強、強脾氣\r\n2.僵硬。[例]項為之強。（《浮生六記》）\r\n\r\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3368",
      "verbatim": true
    },
    {
      "text": "1.體力或能力等健壯、盛大。與「弱」相對。[例]強壯、強國、身強力壯\n2.使健壯、使盛大。[例]強身、富國強兵\n3.勝過、優越。多用於比較。[例]她的語文能力強過我很多。\n4.蠻橫、橫暴。[例]強占、強盜\n5.有餘、略多。[例]三分之二強",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3714",
      "verbatim": true
    },
    {
      "text": "硬要、迫使。[例]強迫、強求、強人所難、強詞奪理",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3720",
      "verbatim": true
    }
  ]
}
