  "definitions_zh_TW": [
    {
      "text": "1.等待、期望。[例]登樓為誰思？臨江遲來客。（南朝宋．謝靈運〈南樓中望所遲客〉詩）\n2.一直到、等到。[例]遲帝還，趙王死。（《漢書．卷九十七．外戚傳上．高祖呂皇后傳》）",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4296",
      "verbatim": true
    },
    {
      "text": "1.緩、慢。[例]遲緩、事不宜遲\n2.晚、不早。[例]遲到、遲歸、姍姍來遲\n3.姓。",
      "lang": "zh-Hant-TW",
