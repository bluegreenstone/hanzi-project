  "definitions_zh_TW": [
    {
      "text": "1.量詞。計算長度的單位。1公尺等於100公分；1臺尺約30公分；1市尺等於33.3公分。\r\n2.量長度的器具。[例]皮尺、鐵尺　◎\r\n3.像尺的條狀物。[例]鎮尺、戒尺",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4637",
      "verbatim": true
    },
    {
      "text": "我國固有的音階符號之一。如上、尺、工、凡、合、四、乙等，統稱為「工尺」。以此編成的曲譜，稱為「工尺譜」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4669",
      "verbatim": true
    }
  ]
