  "definitions_zh_TW": [
    {
      "text": "→番禺縣",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0361",
      "verbatim": true
    },
    {
      "text": "1.舊時對邊境少數民族或外國的稱呼。[例]番邦、土番\r\n2.輪流、接替。[例]番代、番更、番用\r\n3.量詞：(1)計算次數的單位。相當於「回」、「次」。[例]三番兩次、一番心血　(2)計算倍數的單位。[例]連續幾天的漲停板，使他持有的股票價值翻兩番。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0847",
      "verbatim": true
    }
  ]
