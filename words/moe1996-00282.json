  "definitions_zh_TW": [
    {
      "text": "說話結巴不流利的樣子。[例]口吃",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3043",
      "verbatim": true
    },
    {
      "text": "1.口中咀嚼食物後嚥下。有時吸、飲液體也稱為「吃」。[例]吃飯、吃茶、吃藥　◎\n2.捱受、接納。[例]吃驚、吃虧、吃官司\n3.耗費。[例]吃力\n4.吸入、吸收。[例]吃墨、吃煙\n5.下棋、玩牌時奪取對方的棋子或牌張。[例]抽車吃炮、吃掉老Ｋ\n6.沉入。用來說明船舶下沉於水面下程度的用語。[例]這船吃水多深？",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4620",
      "verbatim": true
    }
  ]
