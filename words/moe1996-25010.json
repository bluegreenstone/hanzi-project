  "definitions_zh_TW": [
    {
      "text": "戰後，政府以「山地同胞」指稱日本時代的蕃族或高砂族，簡稱「山胞」，通行於政府與民間。經過1980年代的原住民族運動爭取改名，直到1994年憲法增修條文，才正式將「山胞」改名為「原住民」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
