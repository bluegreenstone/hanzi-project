  "definitions_zh_TW": [
    {
      "text": "1.靠近、投向。[例]若即若離、可望而不可即    \n2.到、登上。[例]即位    \n3.當下。[例]立即、即刻、即知即行    \n4.就是、便是。[例]俯拾即是、非此即彼    \n5.便、就。[例]一觸即發、一發即中    \n6.→即使",
      "lang": "zh-Hant-TW",
