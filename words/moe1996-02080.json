  "definitions_zh_TW": [
    {
      "text": "《論語》的簡稱。[例]論孟",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2151",
      "verbatim": true
    },
    {
      "text": "1.分析、說明。[例]議論、討論、相提並論\r\n2.評定、推斷。[例]論罪、以小論大、推論\r\n3.依據、按照。[例]論理、論件計酬\r\n4.比作、視同、處理。[例]以棄權論、以作廢論、告訴乃論\r\n5.顧及、考慮。[例]不論是非、無論如何\r\n6.主張、學說。[例]理論、輿論",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2153",
      "verbatim": true
