  "definitions_zh_TW": [
    {
      "text": "一種盛行於日本江戶時代（西元1603∼1867）的木版畫。以明豔的色彩，簡練的線條描繪民間風俗、人物、風景等，能充分反映當時的民間生活。浮世繪約風行二百餘年，著名的畫家有鈴木春信、菱川師宣等。",
      "lang": "zh-Hant-TW",
