  "definitions_zh_TW": [
    {
      "text": "脊椎動物亞門鳥綱動物的通稱。卵生，體溫恆定，全身被羽毛。前肢變化為翅膀，能飛行；後肢為腳，用以行走或站立。嘴內無齒，用肺呼吸。一般鳥類均會飛翔，但亦有雙翼退化不能飛的，如雞、鴨、鵝、駝鳥等。種類繁多，遍布世界各地。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1666",
      "verbatim": true
