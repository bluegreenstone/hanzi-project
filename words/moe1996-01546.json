  "definitions_zh_TW": [
    {
      "text": "1.早晨。與「夕」相對。[例]朝陽、朝露、朝令夕改\n2.日、天。[例]今朝、有朝一日\n3.有活力的。[例]朝氣蓬勃",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4354",
      "verbatim": true
    },
    {
      "text": "1.古時諸侯拜見天子。[例]朝貢、朝謁、朝覲\n2.舊時君主聽政、辦事的地方。[例]朝廷、王朝\n3.某一家族或君王的統治時期。[例]漢朝、唐朝、乾隆朝\n4.參拜神明。[例]朝聖、朝山\n5.對、向。[例]朝東、朝前、坐北朝南",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4688",
      "verbatim": true
    }
