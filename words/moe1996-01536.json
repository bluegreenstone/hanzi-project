  "definitions_zh_TW": [
    {
      "text": "→女紅",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2469",
      "verbatim": true
    },
    {
      "text": "1.像鮮血的顏色。[例]血紅、鮮紅\n2.紅色的。[例]紅花、紅豆\n3.變紅、呈現紅色。[例]她被調侃兩句，就害羞臉紅了。\n4.借指花朵。[例]殘紅、落紅\n5.借指美女。[例]偎紅倚翠\n6.顯耀、受到榮寵。[例]走紅、紅星、紅極一時\n7.喜事。[例]紅白大禮\n8.利潤。[例]分紅、紅利",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2993",
      "verbatim": true
    }
  ]
