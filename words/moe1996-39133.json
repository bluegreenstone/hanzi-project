  "definitions_zh_TW": [
    {
      "text": "植物名。一年生草本。莖略呈蔓生狀態，高約一公尺，葉互生，羽狀複葉。夏季開黃色花朵。果實亦稱為「番茄」，呈扁圓形或小球形，為紅色或黃綠色漿果，可供食用或製成果汁。　◎◎",
      "lang": "zh-Hant-TW",
