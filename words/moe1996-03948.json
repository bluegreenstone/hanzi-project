  "definitions_zh_TW": [
    {
      "text": "剛剛興起、正在流行。如：「服務業是新興的熱門行業之一。」《二刻拍案驚奇》卷三九：「蘇州新興百柱帽，少年浮浪的，無不戴著裝幌。」",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
      "source_entry_id": "071630204",
      "verbatim": true
    },
    {
      "text": "新的興趣、興致。唐．李嘉祐〈和韓郎中揚子津玩雪寄嚴維〉詩：「粉署生新興，瑤華寄上才。」唐．殷璠《河嶽英靈集．卷中．賀蘭進明》：「又有古詩八十首，大體符於阮公；又〈行路難〉五首，並多新興。」",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
      "source_entry_id": "0716302071",
      "verbatim": true
    }
  ]
