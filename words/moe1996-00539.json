  "definitions_zh_TW": [
    {
      "text": "1.給予。通「供」。\n2.恭敬。通「恭」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2474",
      "verbatim": true
    },
    {
      "text": "1.一起、一同。[例]共鳴、共事、共襄盛舉\n2.合計、總計。[例]共計、總共\n3.相同的。[例]共識、共相\n4.分享、合用。[例]願車馬衣輕裘與朋友共，敝之而無憾。（《論語．公冶長》）\n5.共產黨的簡稱。[例]俄共、中共",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
