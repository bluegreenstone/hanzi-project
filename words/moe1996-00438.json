  "definitions_zh_TW": [
    {
      "text": "1.連接、連續。[例]相屬\n2.託付。同「囑」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4522",
      "verbatim": true
    },
    {
      "text": "1.類別。[例]金屬\n2.生物分類的名稱之一。[例]界、門、綱、目、科、屬、種\n3.親眷。[例]眷屬、親屬\n4.部下。[例]下屬、部屬\n5.附著、歸於。[例]附屬、歸屬\n6.用十二生肖配十二地支來記生年。[例]丑年出生的人屬牛。\n7.歸某方所有或管轄的。[例]屬地、屬國",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
