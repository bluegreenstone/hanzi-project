  "definitions_zh_TW": [
    {
      "text": "羅馬神話中的月神，亦是主宰狩獵與守護女性貞操的女神。為英語Diana的音譯。在文學詩篇裡常指月亮、女狩獵家、女騎士、獨身主義的女性。今用作女性的名字。也譯作「戴安娜」、「狄安娜」、「地亞娜」。",
      "lang": "zh-Hant-TW",
