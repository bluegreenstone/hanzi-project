  "definitions_zh_TW": [
    {
      "text": "1.見識、學問。[例]知識、真知灼見\n2.明白、了解。[例]知道、知法犯法、相知相許\n3.意識、感覺。[例]知覺、草木無知\n4.通告。[例]通知、知會\n5.朋友。[例]知己、故知、舊雨新知",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4226",
      "verbatim": true
    },
    {
