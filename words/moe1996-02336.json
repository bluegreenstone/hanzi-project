  "definitions_zh_TW": [
    {
      "text": "1.跟在後面或由後面趕上去。[例]追隨、追趕、急起直追　◎\n2.尋求、探究。[例]追蹤、追根究底\n3.催討、索還。[例]追贓、追債\n4.戀愛求偶。[例]倒追、追女朋友\n5.回溯已往。[例]追悼、追溯、追念",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
