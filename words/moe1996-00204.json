  "definitions_zh_TW": [
    {
      "text": "1.計算。[例]數錢\r\n2.列舉責備。[例]數落\r\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5131",
      "verbatim": true
    },
    {
      "text": "1.計算事物的序碼。[例]次數、數目\r\n2.氣運、命運。[例]劫數、氣數、天數\r\n3.幾，為約舉之詞。[例]數次、數日\r\n4.順序、規律、法則。[例]自然之數",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5143",
      "verbatim": true
    },
    {
      "text": "屢次、頻頻。[例]數見不鮮\r\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5154",
      "verbatim": true
    },
    {
      "text": "細密。[例]數罟\r\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5502",
      "verbatim": true
    }
  ]
