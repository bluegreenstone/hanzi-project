  "definitions_zh_TW": [
    {
      "text": "血液經由一定路線，周而復始的循環作用。人體血液自左心室流向大動脈，經全身組織，交換養分、代謝物之後，由靜脈流入右心室，再經肺動脈，進入肺內交換氣體，由肺靜脈流回左心房後，即完成了一次血液循環。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
