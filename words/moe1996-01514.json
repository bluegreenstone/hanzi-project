  "definitions_zh_TW": [
    {
      "text": "1.意旨、意義。[例]這段文字的意思艱深，不容易了解。\n2.情趣、趣味。[例]晚會冷場太多，沒什麼意思。\n3.道義、交情。[例]把難題推給好朋友，實在太不夠意思了。\n4.表示心意。[例]大家各憑能力捐點錢意思意思，不必勉強。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "592200023",
      "verbatim": true
    },
    {
      "text": "心意、想法。[例]仔細推敲對方的意思，似乎同意我們的看法。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5922000221",
      "verbatim": true
    }
  ]
