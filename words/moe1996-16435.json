  "definitions_zh_TW": [
    {
      "text": "植物名。鳳梨科鳳梨屬，多年生草本。葉大，邊緣呈鋸齒狀，花小，淡紫色。果實亦稱為「鳳梨」，形狀如松毬，呈橢圓形，味酸甜芳香。將鳳梨果實上端的冠芽切下種植，即可繁殖成一棵新的植物。　△波羅、菠蘿、楓梨　◎",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
