  "definitions_zh_TW": [
    {
      "text": "1.物質燃燒時所產生的氣體。[例]炊煙、煤煙\n2.東西燃燒而生的煙氣所凝結成的黑灰，常用以製墨。[例]桐煙、鍋煙\n3.山川間像煙一樣的水氣。[例]雲煙、煙霧\n4.特指鴉片。[例]煙土、大煙",
      "lang": "zh-Hant-TW",
