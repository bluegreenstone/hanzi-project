  "definitions_zh_TW": [
    {
      "text": "城市名。南韓的首都。位於朝鮮半島中部，漢江下游北岸。古時為高麗的首都，故古跡頗多；二次世界大戰結束，韓國獨立後，改稱為「索爾」，意為首府，以象徵韓國獨立與自主。現為南韓政治、交通、經濟的中心及第一大城。",
      "lang": "zh-Hant-TW",
