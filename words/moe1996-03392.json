  "definitions_zh_TW": [
    {
      "text": "單數的。與「偶」相對。如 一、 三、 五、七等都是奇數。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3008",
      "verbatim": true
    },
    {
      "text": "1.特別、少有。[例]奇文、稀奇、奇貨可居\n2.怪異、出人意料。[例]奇謀、奇襲、奇兵\n3.極、甚。[例]奇大無比",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
