  "definitions_zh_TW": [
    {
      "text": "1.字。[例]文字、甲骨文\n2.篇章。[例]散文、古文、作文\n3.非關軍事、戰鬥的。與「武」相對。[例]文官、文人\n4.禮節、儀式。[例]繁文縟節\n5.某些有規則的自然現象。[例]天文、水文、地文\n6.溫和、優雅、不猛烈的。[例]溫文、文雅、文火\n7.刺染花紋圖案。[例]文身\n8.量詞。舊時計算銅幣的單位。[例]三文錢、分文不取\n9.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "6387",
      "verbatim": true
    },
    {
      "text": "修飾、掩飾。[例]文飾、文過飾非",
