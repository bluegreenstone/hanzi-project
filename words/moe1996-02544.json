  "definitions_zh_TW": [
    {
      "text": "飼養牲畜的地方。[例]豬圈、牛圈",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3498",
      "verbatim": true
    },
    {
      "text": "1.外圓中空的環狀物。[例]花圈、項圈、橡皮圈\n2.畫環形記號。[例]圈點、圈選\n3.指某些特定行業的範疇。[例]演藝圈、廣告圈、圈內人\n4.量詞。計算環繞次數的單位。[例]三圈鐵絲、繞場一圈",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
