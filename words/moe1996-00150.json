  "definitions_zh_TW": [
    {
      "text": "1.當、該。[例]應該、應當、應有盡有\n2.表示推測之詞。[例]此曲祇應天上有，人間能得幾回聞？（唐．杜甫〈贈花卿〉詩）",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "6188",
      "verbatim": true
    },
    {
      "text": "1.回答、附和。[例]回應、裡應外合、同聲相應\n2.允許、承諾。[例]答應\n3.對付。[例]隨機應變、應接不暇\n4.證實。[例]應驗\n5.適合。[例]得心應手\n6.接受。[例]應邀\n7.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
