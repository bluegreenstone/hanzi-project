  "definitions_zh_TW": [
    {
      "text": "樂聲盈滿於坑谷。引申指道的流行，無不周遍。語本《莊子．天運》：「在谷滿谷，在阬滿阬。」後比喻數量極多，到處都是。《二十年目睹之怪現狀》第五五回：「健模督率各小夥計開箱，開了出來，都是各種的藥水，一瓶一瓶的上了架，頓時滿坑滿谷起來。」",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
      "source_entry_id": "012330081",
      "verbatim": true
    }
