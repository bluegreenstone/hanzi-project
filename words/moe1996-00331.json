  "definitions_zh_TW": [
    {
      "text": "1.治理、收拾。[例]整軍、整頓、整裝\n2.齊一、有秩序的。[例]整齊、整潔\n3.完全的、全部的。[例]整體、完整、整批\n4.教訓、使人受苦。[例]整人\n5.修飾。[例]整修、整容、整形\n6.數學上指沒有小數的。[例]整數",
      "lang": "zh-Hant-TW",
