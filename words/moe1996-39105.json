  "definitions_zh_TW": [
    {
      "text": "猶太人信仰的宗教。經典是由律法書、先知書、聖錄組合的聖經（即基督教所謂的「舊約」）和原為口傳的塔木德。基本教義是以雅赫維（即基督教所稱的耶和華）為唯一真神，深信猶太人為神的唯一選民，認為教義、教規係由雅赫維透過摩西傳授來的。也稱為「以色列教」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
