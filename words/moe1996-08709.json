  "definitions_zh_TW": [
    {
      "text": "原為客廳或接待室之意。因法國在西元十七、十八世紀時，文人學者常聚集在權貴或名媛的客廳中談論文藝時事，故漸成文藝集會的專稱。今也指設計雅緻，供人飲酒談天的場所；或指一項展覽、一個展覽會場，或某種技藝的工作場所。§法 salon [例]攝影沙龍、藝文沙龍、美容沙龍",
      "lang": "zh-Hant-TW",
