  "definitions_zh_TW": [
    {
      "text": "大家，為古時對女子的尊稱。[例]世稱漢代班昭為曹大家。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2342",
      "verbatim": true
    },
    {
      "text": "1.親人共同生活的場所。[例]家庭\n\t\n2.家中的。[例]家事、家產\n\t\n3.尊稱有某種專門學識或專門技術的人。[例]專家、文學家、科學家\n\t\n4.學術流派。[例]儒家、道家、百家爭鳴\n\t\n5.經營某種行業或具有某種身分的人。[例]商家、店家、少東家\n\t\n6.自稱或稱別人。[例]自家、咱家、婦道人家\n\t\n7.對人謙稱自己的親長。[例]家父、家母、家兄\n\t\n8.量詞。計算家庭、店鋪、大型企業等的單位。[例]只此一家，別無分號。\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3119",
      "verbatim": true
    }
  ]
