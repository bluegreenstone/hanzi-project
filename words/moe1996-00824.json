  "definitions_zh_TW": [
    {
      "text": "1.分別。[例]區別、區劃、區隔\n\t\n2.一定範圍的地域。[例]工業區、風景區、吸煙區\n\t\n3.行政上劃分的地方自治單位。[例]萬華區、大同區\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "3752",
      "verbatim": true
    },
    {
      "text": "1.古代的一種容器，可容一斗六升。[例]豆、區、釜、鍾\n\t\n2.姓。\n",
