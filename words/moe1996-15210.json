  "definitions_zh_TW": [
    {
      "text": "一種球類運動。英語table tennis翻譯而來。約於十九、二十世紀間起源於英格蘭。玩法是張網於長方桌上，兩人用球拍對拍乒乓球。分單打和雙打。以先得到二十一分為勝一局，一般比賽採三局二勝或五局三勝制。也稱為「乒乓」、「乒乓球」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
      "source_entry_id": "080250006",
      "verbatim": true
    }
