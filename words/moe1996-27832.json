  "definitions_zh_TW": [
    {
      "text": "地名。在今四川省奉節縣東白帝山。東漢初公孫述據此築城，自稱為「白帝」，故以為名。本為魚復縣城，其後歷為州、郡治所。城居高山，形勢險要。三國時蜀漢以此為防吳重地。劉備伐吳，為陸遜所敗，退居此城，後卒於城西永安宮。也稱為「白帝」。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-revised-dictionary-2015-20260625",
