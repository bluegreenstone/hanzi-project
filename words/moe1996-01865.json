  "definitions_zh_TW": [
    {
      "text": "1.職務更動。[例]調職、調差、外調\n2.派遣、安排。[例]調度、調兵遣將\n3.互換。[例]對調、調換、調位置\n4.提取。[例]借調、抽調、調卷宗\n5.樂律、韻律。[例]音調\n6.音樂上調式的類別和主音高度。如Ｃ大調、Ｄ大調。\n7.語言中字音的高低升降。[例]陽平調、去聲調、入聲調\n8.說話、讀書或朗誦的腔調。[例]南腔北調\n9.言詞、意見。[例]論調、老調、陳腔濫調\n10. 人的風格才情或思想情感。[例]格調、情調",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1190",
      "verbatim": true
    },
    {
      "text": "1.使和諧、使均勻合適。[例]調和、調劑\n2.使和解。[例]調解、協調\n3.混合、配合。[例]調色、調味\n4.嘲笑、戲弄、挑逗。[例]調侃、調戲\n5.和暢、搭配得很合適。[例]風調雨順",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "1468",
      "verbatim": true
    }
  ]
