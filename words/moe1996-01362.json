  "definitions_zh_TW": [
    {
      "text": "→色子",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4981",
      "verbatim": true
    },
    {
      "text": "1.物體表面的光彩。[例]顏色、色彩、五顏六色\n2.表情、臉色。[例]神色、不動聲色、和顏悅色\n3.景象、情景。[例]夜色、秋色、暮色\n4.種類、式樣。[例]貨色、花色\n5.性慾、情慾。[例]食、色，性也。（《孟子．告子上》）\n6.品質、成分。多指金銀而言。[例]音色、成色、九九足色\n7.容顏、容貌。[例]絕色、姿色",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
