  "definitions_zh_TW": [
    {
      "text": "城市名。位於臺灣北部新竹平原中心。面積約一百零四平方公里。地形平坦，有縱貫鐵路經過。工業以化學工業和輕工業為主，市內有科學工業園區、國立清華大學與國立陽明交通大學。特產新竹米粉及貢丸。市郊有古奇峰、青草湖等名勝古蹟。",
      "lang": "zh-Hant-TW",
