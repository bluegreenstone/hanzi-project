  "definitions_zh_TW": [
    {
      "text": "1.使人或動物等失去生命。[例]殺人、殺雞、殺蟲\n2.戰鬥。[例]殺出重圍\n3.敗壞。[例]殺風景\n4.削減。[例]殺價\n5.極甚，到了極點。[例]氣殺、愁殺",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4954",
      "verbatim": true
    },
    {
      "text": "等差。[例]其族食世降一等，親親之殺也。（《禮記．文王世子》）",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
