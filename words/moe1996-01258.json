  "definitions_zh_TW": [
    {
      "text": "量詞。計算容量的單位。公制一合等於一升的十分之一。　△公合",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2218",
      "verbatim": true
    },
    {
      "text": "1.將離散的部分聚集在一起。與「分」相對。[例]集合、聚合\n2.關閉。[例]合眼、合不上嘴\n3.全部、整個。[例]合家平安、合鄉稱頌\n4.相符、不違背。[例]合法、合身、合意\n5.折算。[例]五臺斤合三公斤。\n6.應該、應當。[例]合該\n7.交配、交媾。[例]交合、媾合\n8.共同、一起。[例]合抱、合力、合唱\n9.和諧、融洽。[例]百年好合\n10. 配偶。[例]天作之合",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "2679",
      "verbatim": true
    }
  ]
