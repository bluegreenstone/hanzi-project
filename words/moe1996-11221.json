  "definitions_zh_TW": [
    {
      "text": "不安穩、不妥當。宋．歐陽修〈漁家傲．昨日採花花欲盡〉詞：「羅袖挹殘心不穩，羞人問，歸來剩把胭脂襯。」《文明小史》第九回：「他二人立腳不穩只好站在路旁，等候這班人退過，再圖前進。」",
      "lang": "zh-Hant-TW",
