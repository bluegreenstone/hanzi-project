  "definitions_zh_TW": [
    {
      "text": "1.天干的第四位。\n2.排列次序的等第。在甲、乙、丙之後，表示第四級，或較差的等級。\n3.成年男子。[例]壯丁、男丁、單丁\n4.人、人口。[例]人丁單薄\n5.從事某些勞動職業的人。[例]園丁、庖丁、家丁\n6.方形的小型塊狀物。[例]雞丁、肉丁\n7.遭逢。[例]丁憂\n8.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
