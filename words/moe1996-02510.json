  "definitions_zh_TW": [
    {
      "text": "量詞。計算馬、騾、驢等牲畜的單位。[例]一匹馬、兩匹驢、單槍匹馬",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "0414",
      "verbatim": true
    },
    {
      "text": "1.實力相當。[例]匹配、匹敵\n\t\n2.配合。[例]匹配\n\t\n3.單一的、單獨的。[例]匹夫、匹婦\n\t\n4.量詞。計算布帛類紡織品的單位。[例]一匹布、兩匹綢子\n",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
