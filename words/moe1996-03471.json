  "definitions_zh_TW": [
    {
      "text": "1.事情的發生或出現。[例]興起\n2.發動。[例]興師問罪\n3.創立、建造。[例]興辦、興建、興學\n4.流行、盛行。[例]時興\n5.起來、起身。[例]夙興夜寐\n6.昌盛、旺盛。與「衰」相對。[例]興隆、興盛",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4091",
      "verbatim": true
    },
    {
      "text": "1.情致、趣味。[例]助興、盡興、掃興\r\n2.《詩》六義之一。藉其他事物以引發起所敘說事物的詩歌寫作方法。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
