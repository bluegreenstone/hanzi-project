  "definitions_zh_TW": [
    {
      "text": "1.呼吸時出入的氣流。[例]氣息、鼻息、奄奄一息\n2.停止、消失。[例]止息、息怒、川流不息\n3.停止活動，放鬆身心。[例]歇息、休息\n4.音訊、音信。[例]信息、訊息\n5.利錢。[例]利息、月息、年息\n6.子女、兒子。[例]子息、兒息",
      "lang": "zh-Hant-TW",
