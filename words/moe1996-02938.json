  "definitions_zh_TW": [
    {
      "text": "1.不冷不熱。[例]溫暖、溫水、溫帶\n2.柔和、良善。[例]溫柔敦厚、溫文儒雅\n3.使暖和。[例]溫酒、溫被\n4.複習。[例]溫書、溫故而知新\n5.冷熱的程度。[例]體溫、室溫、高溫\n6.姓。",
      "lang": "zh-Hant-TW",
