  "definitions_zh_TW": [
    {
      "text": "謙卑、恭順。[例]孫心、不孫",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4202",
      "verbatim": true
    },
    {
      "text": "1.稱謂：(1) 稱兒子、女兒的子女。[例]孫兒、孫女　(2) 稱直系自孫子以下的後代。[例]曾孫、玄孫　(3) 稱與孫同輩的親族。[例]姪孫、甥孫\r\n2.泛指後代。[例]王孫\r\n3.再生或孳生之物。[例]竹孫、稻孫\r\n4.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
