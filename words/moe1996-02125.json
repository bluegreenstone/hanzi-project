  "definitions_zh_TW": [
    {
      "text": "量詞。計算時間的單位。相當於「年」。[例]一年半載、三年五載、千載難逢",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5323",
      "verbatim": true
    },
    {
      "text": "1.裝運。[例]載人、載貨\n2.記錄。[例]記載、刊載、轉載\n3.承受。[例]水能載舟、厚德載物\n4.充滿。[例]怨聲載道\n5.一再、重複。通「再」。[例]載歌載舞\n6.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "5326",
      "verbatim": true
