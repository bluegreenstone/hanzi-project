  "definitions_zh_TW": [
    {
      "text": "1.彼此、交互。[例]互相、守望相助、相親相愛\n2.指一方對另一方的行為。通常用於動詞前。[例]另眼相看、有事相煩、實不相瞞\n3.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4057",
      "verbatim": true
    },
    {
      "text": "1.容貌、外形。[例]長相、福相、吃相\n2.輔佐國君綜治國政的主要官員。[例]宰相、丞相、首相\n3.審視、察看。[例]相時而動、相機行事\n4.觀察容貌等以斷吉凶。[例]相命\n5.輔導行禮的人。[例]儐相\n6.輔佐、幫助。[例]吉人天相\n7.姓。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
      "source_id": "moe-tw-concised-dictionary-2014-20260626",
      "source_entry_id": "4081",
      "verbatim": true
    }
  ]
