  "definitions_zh_TW": [
    {
      "text": "1.交付、授與。[例]給錢\r\n2.替、為。[例]請你給我拿些吃的。\r\n3.向。[例]快給他道謝。\r\n4.被、受。[例]想不到大家都給他騙了。",
      "lang": "zh-Hant-TW",
      "register": "dictionary",
