{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hanzi-project/schema/character.schema.json",
  "title": "Traditional-primary character record (through Phase 4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codepoint",
    "traditional",
    "simplified",
    "simplification_note",
    "variants_異體字",
    "radical",
    "total_strokes",
    "total_strokes_standard",
    "stroke_count_variants",
    "ids_decomposition",
    "components",
    "liushu_六書",
    "readings",
    "english_translation",
    "definitions",
    "frequency",
    "grading",
    "confusable_with",
    "kangxi_citation",
    "stroke_order",
    "sources",
    "gaps",
    "conflicts"
  ],
  "properties": {
    "codepoint": { "$ref": "#/$defs/codepoint" },
    "traditional": { "$ref": "#/$defs/singleCharacter" },
    "simplified": {
      "oneOf": [
        { "$ref": "#/$defs/singleCharacter" },
        { "type": "null" }
      ]
    },
    "simplification_note": {
      "oneOf": [
        { "$ref": "#/$defs/simplificationNote" },
        { "type": "null" }
      ]
    },
    "variants_異體字": {
      "type": "array",
      "items": { "$ref": "#/$defs/variant" }
    },
    "radical": { "$ref": "#/$defs/radicalAssignment" },
    "total_strokes": { "type": "integer", "minimum": 1 },
    "total_strokes_standard": { "const": "TW-MOE-1996" },
    "stroke_count_variants": {
      "type": "array",
      "items": { "$ref": "#/$defs/strokeCountVariant" }
    },
    "ids_decomposition": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "components": {
      "oneOf": [
        {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/codepoint" }
        },
        { "type": "null" }
      ]
    },
    "liushu_六書": {
      "oneOf": [
        { "$ref": "#/$defs/liushu" },
        { "type": "null" }
      ]
    },
    "readings": { "$ref": "#/$defs/readings" },
    "english_translation": {
      "type": "string",
      "minLength": 1
    },
    "definitions": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/definition" }
        },
        { "type": "null" }
      ]
    },
    "frequency": { "$ref": "#/$defs/frequency" },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hsk", "tocfl"],
      "properties": {
        "hsk": { "type": "null" },
        "tocfl": { "type": "null" }
      }
    },
    "confusable_with": { "type": "null" },
    "common_words": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^moe1996-[0-9]{5}$"
      }
    },
    "kangxi_citation": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "stroke_order": {
      "oneOf": [
        { "$ref": "#/$defs/strokeOrder" },
        { "type": "null" }
      ]
    },
    "sources": { "$ref": "#/$defs/sourceMap" },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "$defs": {
    "codepoint": {
      "type": "string",
      "pattern": "^U\\+[0-9A-F]{4,6}$"
    },
    "singleCharacter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "simplificationNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_type", "simplified", "traditional_origins"],
      "properties": {
        "mapping_type": { "const": "many_traditional_to_one_simplified" },
        "simplified": { "$ref": "#/$defs/codepoint" },
        "traditional_origins": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/codepoint" }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["char", "codepoint", "relationship", "source_property"],
      "properties": {
        "char": { "$ref": "#/$defs/singleCharacter" },
        "codepoint": { "$ref": "#/$defs/codepoint" },
        "relationship": {
          "enum": [
            "semantic",
            "specialized_semantic",
            "spoofing",
            "traditional",
            "z_variant"
          ]
        },
        "source_property": {
          "enum": [
            "kSemanticVariant",
            "kSpecializedSemanticVariant",
            "kSpoofingVariant",
            "kTraditionalVariant",
            "kZVariant"
          ]
        }
      }
    },
    "radicalAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kangxi_number",
        "residual_strokes",
        "source_assignment",
        "additional_assignments"
      ],
      "properties": {
        "kangxi_number": { "type": "integer", "minimum": 1, "maximum": 214 },
        "residual_strokes": { "type": "integer", "minimum": -1 },
        "source_assignment": { "type": "string", "minLength": 3 },
        "additional_assignments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "strokeCountVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "region", "convention", "source_id"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "region": { "enum": ["TW", "CN", "und"] },
        "convention": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 }
      }
    },
    "liushu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "type",
        "semantic_component",
        "phonetic_component",
        "hint"
      ],
      "properties": {
        "source_type": {
          "enum": ["pictophonetic", "pictographic", "ideographic"]
        },
        "type": {
          "oneOf": [
            { "const": "形聲" },
            { "type": "null" }
          ]
        },
        "semantic_component": {
          "oneOf": [
            { "$ref": "#/$defs/codepoint" },
            { "type": "null" }
          ]
        },
        "phonetic_component": {
          "oneOf": [
            { "$ref": "#/$defs/codepoint" },
            { "type": "null" }
          ]
        },
        "hint": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pinyin": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reading", "context", "region", "standard"],
            "properties": {
              "reading": { "type": "string", "minLength": 1 },
              "context": { "enum": ["primary", "additional"] },
              "region": { "enum": ["TW", "und"] },
              "standard": {
                "enum": ["TW-CNS11643", "Unicode-kMandarin-fallback"]
              }
            }
          }
        },
        "pinyin_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reading", "region", "classification", "source_id", "source_property"],
            "properties": {
              "reading": { "type": "string", "minLength": 1 },
              "region": { "enum": ["CN", "und"] },
              "classification": {
                "enum": [
                  "regional_preference",
                  "regional_attestation",
                  "unicode_attestation",
                  "dictionary_attestation"
                ]
              },
              "source_id": { "type": "string", "minLength": 1 },
              "source_property": { "type": "string", "minLength": 1 }
            }
          }
        },
        "zhuyin": { "$ref": "#/$defs/nonemptyStrings" },
        "jyutping": { "$ref": "#/$defs/nonemptyStrings" },
        "japanese_on": { "$ref": "#/$defs/nonemptyStrings" },
        "japanese_kun": { "$ref": "#/$defs/nonemptyStrings" },
        "korean": { "$ref": "#/$defs/nonemptyStrings" },
        "hangul": { "$ref": "#/$defs/nonemptyStrings" },
        "fanqie": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gloss", "lang", "register", "source_id"],
      "properties": {
        "gloss": { "type": "string", "minLength": 1 },
        "lang": { "const": "en" },
        "register": { "const": "modern" },
        "source_id": { "type": "string", "minLength": 1 }
      }
    },
    "strokeType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name_zh"],
      "properties": {
        "code": { "enum": ["1", "2", "3", "4", "5"] },
        "name_zh": { "enum": ["橫", "豎", "撇", "點", "折"] }
      }
    },
    "strokeOrderConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "prc_path_count", "taiwan_count", "source_ids", "detail"],
      "properties": {
        "field": { "const": "stroke_count" },
        "prc_path_count": { "type": "integer", "minimum": 1 },
        "taiwan_count": { "type": "integer", "minimum": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "strokeOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svg_asset_id",
        "standard",
        "source_convention",
        "formal_conformance",
        "stroke_count",
        "stroke_types",
        "taiwan_cns_stroke_sequence",
        "standard_conflicts"
      ],
      "properties": {
        "svg_asset_id": { "type": "string", "pattern": "^stroke-order-U\\+[0-9A-F]{4,6}-(?:mmah-bddc96d4|reconstructed-components-v1)$" },
        "standard": { "const": "PRC GF 0023-2020 (provisional baseline)" },
        "source_convention": {
          "enum": [
            "Make Me a Hanzi PRC stroke order",
            "Reconstructed component geometry; Taiwan CNS stroke sequence"
          ]
        },
        "formal_conformance": { "const": "not_verified" },
        "stroke_count": { "type": "integer", "minimum": 1 },
        "stroke_types": { "type": "null" },
        "taiwan_cns_stroke_sequence": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/strokeType" }
            },
            { "type": "null" }
          ]
        },
        "standard_conflicts": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/strokeOrderConflict" }
        }
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "selection_rank",
        "corpus_id",
        "count",
        "cumulative_count",
        "cumulative_percentage",
        "per_million",
        "corpus_total_count"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "selection_rank": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "corpus_id": { "const": "moe-tw-common-terms-1996" },
        "count": { "type": "integer", "minimum": 1 },
        "cumulative_count": { "type": "integer", "minimum": 1 },
        "cumulative_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "per_million": { "type": "number", "exclusiveMinimum": 0 },
        "corpus_total_count": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "detail"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": [
            "not_attested",
            "source_unavailable",
            "conflicting_sources",
            "license_prohibits_use"
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "conflictValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_ids"],
      "properties": {
        "value": true,
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "resolution", "values", "detail"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "resolution": {
          "enum": [
            "tw_canonical_variant_retained",
            "tw_canonical_prc_variant_retained",
            "unresolved",
            "recorded_no_value_change"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/conflictValue" }
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
