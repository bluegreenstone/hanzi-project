{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hanzi-project/schema/stroke-order-asset.schema.json",
  "title": "Stroke-order SVG asset entry",
  "oneOf": [
    { "$ref": "#/$defs/exactSourceAsset" },
    { "$ref": "#/$defs/reconstructedAsset" }
  ],
  "$defs": {
    "exactSourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id", "asset_type", "codepoint", "character", "source_id",
        "source_file", "source_commit", "source_record_index",
        "source_record_sha256", "local_path", "sha256", "bytes",
        "mime_type", "width", "height", "stroke_count", "license_id",
        "license_url", "attribution_required", "required_attribution",
        "transformations", "standard", "source_convention",
        "formal_conformance"
      ],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^stroke-order-U\\+[0-9A-F]{4,6}-mmah-bddc96d4$" },
        "asset_type": { "const": "stroke_order" },
        "codepoint": { "$ref": "#/$defs/codepoint" },
        "character": { "$ref": "#/$defs/character" },
        "source_id": { "const": "makemeahanzi-graphics-master-audit" },
        "source_file": { "const": "source-data/makemeahanzi-bddc96d4/graphics.txt" },
        "source_commit": { "const": "bddc96d41bef78427ed0e034e9f7e31d71fd1b92" },
        "source_record_index": { "type": "integer", "minimum": 1 },
        "source_record_sha256": { "$ref": "#/$defs/sha256" },
        "local_path": { "type": "string", "pattern": "^assets/stroke-order/U\\+[0-9A-F]{4,6}/makemeahanzi-bddc96d4\\.svg$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "mime_type": { "const": "image/svg+xml" },
        "width": { "const": 1024 },
        "height": { "const": 1024 },
        "stroke_count": { "type": "integer", "minimum": 1 },
        "license_id": { "const": "Arphic-1999" },
        "license_url": { "type": "string", "minLength": 1 },
        "attribution_required": { "const": true },
        "required_attribution": { "type": "string", "minLength": 1 },
        "transformations": { "$ref": "#/$defs/transformations" },
        "standard": { "$ref": "#/$defs/standard" },
        "source_convention": { "const": "Make Me a Hanzi PRC stroke order" },
        "formal_conformance": { "const": "not_verified" }
      }
    },
    "reconstructedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id", "asset_type", "codepoint", "character",
        "provenance_type", "source_ids", "source_files", "source_commit",
        "component_sources", "order_source", "geometry_status",
        "exact_source_gap", "local_path", "sha256", "bytes", "mime_type",
        "width", "height", "stroke_count", "license_id", "license_url",
        "attribution_required", "required_attribution", "transformations",
        "standard", "source_convention", "formal_conformance"
      ],
      "properties": {
        "asset_id": { "const": "stroke-order-U+6C59-reconstructed-components-v1" },
        "asset_type": { "const": "stroke_order" },
        "codepoint": { "const": "U+6C59" },
        "character": { "const": "汙" },
        "provenance_type": { "const": "reconstructed" },
        "source_ids": {
          "type": "array",
          "prefixItems": [
            { "const": "makemeahanzi-graphics-master-audit" },
            { "const": "cns11643-attributes-2026-08-05" }
          ],
          "items": false
        },
        "source_files": {
          "type": "array",
          "prefixItems": [
            { "const": "source-data/makemeahanzi-bddc96d4/graphics.txt" },
            { "const": "source-data/cns11643-2026-08-05/Properties.zip" }
          ],
          "items": false
        },
        "source_commit": { "const": "bddc96d41bef78427ed0e034e9f7e31d71fd1b92" },
        "component_sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/componentSource" }
        },
        "order_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "sequence", "type_mapping"],
          "properties": {
            "source_id": { "const": "cns11643-attributes-2026-08-05" },
            "sequence": { "const": "444115" },
            "type_mapping": { "const": "1=橫, 2=豎, 3=撇, 4=點, 5=折" }
          }
        },
        "geometry_status": { "const": "reconstructed_not_attested" },
        "exact_source_gap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "detail"],
          "properties": {
            "reason": { "const": "source_unavailable" },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "local_path": { "const": "assets/stroke-order/U+6C59/reconstructed-components-v1.svg" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "mime_type": { "const": "image/svg+xml" },
        "width": { "const": 1024 },
        "height": { "const": 1024 },
        "stroke_count": { "const": 6 },
        "license_id": { "const": "Arphic-1999" },
        "license_url": { "type": "string", "minLength": 1 },
        "attribution_required": { "const": true },
        "required_attribution": { "type": "string", "minLength": 1 },
        "transformations": { "$ref": "#/$defs/transformations" },
        "standard": { "$ref": "#/$defs/standard" },
        "source_convention": { "const": "Reconstructed component geometry; Taiwan CNS stroke sequence" },
        "formal_conformance": { "const": "not_verified" }
      }
    },
    "componentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "character", "codepoint", "source_record_index",
        "source_record_sha256", "source_stroke_indices",
        "target_stroke_indices", "path_transform"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "character": { "$ref": "#/$defs/character" },
        "codepoint": { "$ref": "#/$defs/codepoint" },
        "source_record_index": { "type": "integer", "minimum": 1 },
        "source_record_sha256": { "$ref": "#/$defs/sha256" },
        "source_stroke_indices": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "target_stroke_indices": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "path_transform": { "type": "string", "minLength": 1 }
      }
    },
    "codepoint": { "type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$" },
    "character": { "type": "string", "minLength": 1, "maxLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "transformations": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "standard": { "const": "PRC GF 0023-2020 (provisional baseline)" }
  }
}
